{
    "name": "live2d-viewer",
    "private": false,
    "version": "0.3.0",
    "description": "Standalone Live2D model viewer with motion, audio, parameter, and part controls. Powered by PixiJS and untitled-pixi-live2d-engine.",
    "type": "module",
    "license": "MIT",
    "scripts": {
        "dev": "bunx --bun vite dev",
        "build": "bunx --bun vite build",
        "build:static": "BUILD_TARGET=static bunx --bun vite build",
        "build:lib": "bunx --bun vite build --config vite.config.lib.ts",
        "preview": "bunx --bun vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
    },
    "dependencies": {
        "@lucide/svelte": "^0.561.0",
        "@pixi/sound": "^6.0.1",
        "@pixi/ticker": "^7.4.0",
        "@types/stats.js": "^0.17.4",
        "fitty": "^2.4.2",
        "fuse.js": "^7.5.0",
        "interactjs": "^1.10.27",
        "pixi.js": "^8.13.1",
        "stats.js": "^0.17.0",
        "untitled-pixi-live2d-engine": "^1.3.5"
    },
    "devDependencies": {
        "@sveltejs/adapter-node": "^5.4.0",
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/kit": "^2.70.3",
        "@sveltejs/vite-plugin-svelte": "^7.3.0",
        "@tailwindcss/vite": "^4.1.14",
        "bits-ui": "^2.14.4",
        "clsx": "^2.1.1",
        "paneforge": "^1.0.2",
        "svelte": "^5.41.0",
        "svelte-check": "^4.3.3",
        "tailwind-merge": "^3.4.0",
        "tailwind-variants": "^3.2.2",
        "tailwindcss": "^4.1.14",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.9.3",
        "vite": "^8.2.2"
    }
}
