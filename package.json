{
    "name": "live2d-viewer",
    "private": false,
    "version": "0.1.0",
    "description": "Standalone Live2D model viewer with motion, audio, parameter, and part controls. Powered by PixiJS and pixi-live2d-display-advanced.",
    "type": "module",
    "license": "MIT",
    "scripts": {
        "dev": "bunx --bun vite dev",
        "build": "bunx --bun vite build",
        "preview": "bunx --bun vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
    },
    "dependencies": {
        "@lucide/svelte": "^0.561.0",
        "@pixi/sound": "^6.0.1",
        "@pixi/ticker": "^7.4.0",
        "@types/stats.js": "^0.17.4",
        "interactjs": "^1.10.27",
        "pixi-live2d-display-advanced": "^1.0.1",
        "pixi.js": "^7.4.0",
        "stats.js": "^0.17.0"
    },
    "devDependencies": {
        "@sveltejs/adapter-node": "^5.4.0",
        "@sveltejs/kit": "^2.47.1",
        "@sveltejs/vite-plugin-svelte": "^6.2.1",
        "@tailwindcss/vite": "^4.1.14",
        "bits-ui": "^2.14.4",
        "clsx": "^2.1.1",
        "paneforge": "^1.0.2",
        "svelte": "^5.41.0",
        "svelte-check": "^4.3.3",
        "tailwind-merge": "^3.4.0",
        "tailwind-variants": "^3.2.2",
        "tailwindcss": "^4.1.14",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.9.3",
        "vite": "^7.1.10"
    }
}
